  debug: 0
  value:
    UseConstant: 1
    ConstantValue: 0
    Variable: {fileID: 0}
  Raise:
    m_PersistentCalls:
      m_Calls: []
  compare:
  - active: 1
    name: 'Stamina Lower Than '
    description: 'Disable the Dodge Mode if the Stamina is lower than 25.

      Disable
      the 1st  comparer and Enable the second one.'
    comparer: 2
    Value:
      UseConstant: 1
      ConstantValue: 25
      Variable: {fileID: 0}
    Response:
      m_PersistentCalls:
        m_Calls:
